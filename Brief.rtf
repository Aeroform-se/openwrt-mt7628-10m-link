\f0\b\fs36 \cf0 \expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Project Brief: MT7628 PHY Link Override via Kernel Module\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 Objective:
\f1\b0  Force a TP-Link TL-WR902AC v3 (MediaTek MT7628 / OpenWrt 23.05.5) Ethernet port to negotiate at 10Mbps Half-Duplex to support a legacy Asante MacCon network card on a Macintosh SE/30.\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Scope & Architecture constraints\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls1\ilvl0
\fs24 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 The Problem:
\f1\b0  OpenWrt userspace tools (
\f2\fs26 ethtool
\f1\fs24 , 
\f2\fs26 mii-tool
\f1\fs24 , 
\f2\fs26 swconfig
\f1\fs24 ) fail due to missing driver API hooks, and direct memory manipulation tools (
\f2\fs26 devmem
\f1\fs24 , 
\f2\fs26 phytool
\f1\fs24 ) are blocked by kernel restrictions or absent from the 
\f2\fs26 ramips/mt76x8
\f1\fs24  package repository.\
\ls1\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 The Solution:
\f1\b0  A custom Loadable Kernel Module (LKM) running in Ring 0. The LKM maps physical memory using 
\f2\fs26 ioremap
\f1\fs24  to bypass 
\f2\fs26 /dev/mem
\f1\fs24  restrictions, writes the hardcoded 10Base-T half-duplex hex values directly to the switch silicon, and safely unmaps.\
\ls1\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Failsafe & Testing Plan:
\f1\b0  The module will be manually tested via 
\f2\fs26 insmod
\f1\fs24  in a volatile SSH session. If a kernel panic occurs, a hard power cycle clears the RAM. If added to 
\f2\fs26 /etc/rc.local
\f1\fs24  later and it boot-loops, OpenWrt's hardware failsafe mode will be used to mount the root filesystem and remove the script.\
\ls1\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Driver Edge-Case:
\f1\b0  The default 
\f2\fs26 rt305x-esw
\f1\fs24  driver uses a polling loop. If the driver detects the PHY change and auto-resets the port, the C code must be expanded to disable the polling loop or persistently re-apply the register state via a kernel timer.\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Hardware Memory Mapping\
\pard\tx220\tx720\pardeftab720\li720\fi-720\sa240\partightenfactor0
\ls2\ilvl0
\fs24 \cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Base Address:
\f1\b0  
\f2\fs26 0x10110000
\f1\fs24  (MT7628 Switch Base)\
\ls2\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 PIAC Register Offset:
\f1\b0  
\f2\fs26 0x7004
\f1\fs24  (PHY Indirect Access Control)\
\ls2\ilvl0
\f0\b \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u8226 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Payload:
\f1\b0  
\f2\fs26 0x88000000
\f1\fs24 \
\pard\tx940\tx1440\pardeftab720\li1440\fi-1440\sa240\partightenfactor0
\ls2\ilvl1\cf0 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u9702 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Bit 31: Write Enable (1)\
\ls2\ilvl1\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u9702 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Bits 29:25: PHY Address (4) \'97 
\f3\i Note: Fallback is 0 if 4 fails.
\f1\i0 \
\ls2\ilvl1\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u9702 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Bits 24:20: Register (0 - Basic Control)\
\ls2\ilvl1\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	\uc0\u9702 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Bits 15:0: Data (
\f2\fs26 0x0000
\f1\fs24  forces 10Mbps, Half-Duplex, Auto-neg OFF)\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Source Code\
\pard\pardeftab720\sa240\partightenfactor0

\fs24 \cf0 1. 
\f4\fs26 mac_se30_link.c
\f1\b0\fs24 \
\pard\pardeftab720\partightenfactor0
\cf0 C\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 #include <linux/module.h>\
#include <linux/io.h>\
\
#define MT7628_SW_BASE 0x10110000\
#define PIAC_OFFSET 0x7004\
\
static int __init mac_link_init(void) \{\
    void __iomem *sw_base;\
    \
    // Map the physical memory directly, bypassing userspace blocks\
    sw_base = ioremap(MT7628_SW_BASE, 0x8000);\
    if (!sw_base) \{\
        printk(KERN_ERR "MacSE30 Link: Failed to map memory\\n");\
        return -ENOMEM;\
    \}\
\
    printk(KERN_INFO "MacSE30 Link: Forcing MT7628 PHY 4 to 10Mbps Half-Duplex...\\n");\
    // Command: Write Enable | PHY 4 | Reg 0 | Data 0x0000\
    iowrite32(0x88000000, sw_base + PIAC_OFFSET);\
\
    iounmap(sw_base);\
    \
    // Return non-zero to execute logic and instantly unload from the kernel\
    return -1; \
\}\
\
MODULE_LICENSE("GPL");\
module_init(mac_link_init);\
\pard\pardeftab720\sa240\partightenfactor0

