\f2\fs26 \cf0 obj-m += mac_se30_link.o\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Build Pipeline & Deployment (Docker)\
\pard\pardeftab720\sa240\partightenfactor0

\f1\b0\fs24 \cf0 Instead of a complex local cross-compiler toolchain, compilation will be handled via the official OpenWrt SDK Docker image for the target architecture.\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b \cf0 Step 1: Execute Compiler Container
\f1\b0  Run inside the directory containing the source files on macOS:\
\pard\pardeftab720\partightenfactor0
\cf0 Bash\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 docker run --rm -it -v $(pwd):/ext openwrt/sdk:ramips-mt76x8-23.05.5\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Step 2: Cross-Compile (Inside Docker shell)
\f1\b0 \
\pard\pardeftab720\partightenfactor0
\cf0 Bash\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 make -C /builder/build_dir/target-mipsel_24kc_musl/linux-ramips_mt76x8/linux-5.15.* M=/ext modules\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Step 3: Transfer to Router
\f1\b0  Exit Docker and push the compiled 
\f2\fs26 .ko
\f1\fs24  file to OpenWrt using macOS legacy SCP:\
\pard\pardeftab720\partightenfactor0
\cf0 Bash\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 scp -O mac_se30_link.ko root@192.168.1.1:/root/\
\pard\pardeftab720\sa240\partightenfactor0

\f0\b\fs24 \cf0 Step 4: Execute & Verify
\f1\b0  SSH into the router and load the module:\
\pard\pardeftab720\partightenfactor0
\cf0 Bash\
\
\pard\pardeftab720\partightenfactor0

\f2\fs26 \cf0 insmod /root/mac_se30_link.ko\
\pard\pardeftab720\sa240\partightenfactor0

\f1\fs24 \cf0 Check kernel logs via 
\f2\fs26 dmesg | tail
\f1\fs24  and observe the physical link light on the Mac SE/30.\
}